# Normalize line endings.
#
# Without this, GitHub's Windows runners check out with core.autocrlf=true and
# every .go file arrives with CRLF, which `gofmt -l` reports as unformatted —
# so CI fails on Windows only. Force LF in the working tree on every platform.
* text=auto eol=lf

# Explicitly text, LF.
*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.work    text eol=lf
*.proto   text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.html    text eol=lf
*.css     text eol=lf
*.java    text eol=lf
*.kt      text eol=lf
*.gradle  text eol=lf
*.plist   text eol=lf
*.conf    text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Windows batch files only work with CRLF.
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Never touched.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.icns    binary
*.pdf     binary
*.bin     binary
*.jar     binary
*.keystore binary
*.dmg     binary
*.exe     binary
