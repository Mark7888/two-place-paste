<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The camera is used for one thing: scanning a pairing QR code (SPEC §3.2).
      It is optional hardware, because pasting the pairing code is an equal
      path and a device without a camera must still be able to join.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      Saving a received file to Downloads. Android 10+ does that through
      MediaStore with no permission at all, so this is only requested on 9 and
      older, and only at the moment the user taps "Save to Downloads".
    -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      There is no accessibility service and no BIND_ACCESSIBILITY_SERVICE.
      Background clipboard access is not attempted at all (SPEC §7.1): the
      quick-settings tile foregrounds the app, which is the only legal moment
      to read the clipboard on Android 10+.

      The one foreground service, TransferService, has nothing to do with the
      clipboard. It carries an upload the user started from the share panel
      after the panel closes, with a notification showing its progress
      (POST_NOTIFICATIONS, asked for when the user first sends something from
      the panel). WAKE_LOCK is what React Native's headless task service holds
      while the upload runs.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Pairing links (SPEC §3.2).

              A scheme-only filter, and deliberately so. An https filter would
              need a concrete android:host — Android ignores pathPrefix unless
              one is given, so a host-less https filter would register this app
              as a handler for every web link on the device. And a host cannot
              be named here anyway: every deployment is somebody's own relay.

              So the https link a QR carries goes to that relay, which serves a
              page that hands the code on through this scheme. The code is in
              the fragment either way, so it never reaches the relay.

              The match is on the authority (tpp://pair), not a path, for the
              same reason: a path is only honoured when a host is present.
            -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tpp" android:host="pair" />
            </intent-filter>
        </activity>

        <!--
          The window a tile tap opens (SPEC §7.1): a transparent panel over
          whatever the user is doing, rather than the whole app.

          It is not exported — only this app's own tile starts it. Its own
          task affinity and excludeFromRecents keep a one-shot panel out of
          the recents list and stop it becoming what the launcher returns to
          instead of the app. `singleTask` means a second tap reuses the panel
          that is already up.
        -->
        <activity
            android:name=".SyncOverlayActivity"
            android:theme="@style/AppTheme.Overlay"
            android:label="@string/tile_label"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:taskAffinity=".SyncOverlay"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <!--
          The panel "Share → TwoPlacePaste" opens: one file, one image or a
          piece of text, which the user then chooses to send to the group or
          save to the store. Nothing is uploaded until they do.

          ACTION_SEND only: sharing several items at once is not offered, so a
          multi-item share does not list this app. `*/*` covers text/plain
          too. Exported, because the share sheet is another app; what it is
          handed is checked in ShareModule, which reads only content:// URIs
          that this app does not serve itself.

          The same panel setup as the tile's: its own task, out of recents,
          `singleTask` so a second share reuses the panel that is up. Not
          `noHistory`, unlike the tile's panel: a file is read with the grant
          that came with the share, which lasts only as long as this activity.
        -->
        <activity
            android:name=".ShareActivity"
            android:theme="@style/AppTheme.Overlay"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:taskAffinity=".Share"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <!--
          Background uploads from the share panel (TransferService): a
          foreground service running React Native's headless JS task. Not
          exported — only this app starts it.
        -->
        <service
            android:name=".TransferService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!--
          The quick-settings tile (SPEC §7.1). android:exported is required for
          a TileService, and BIND_QUICK_SETTINGS_TILE means only the system may
          bind it.
        -->
        <service
            android:name=".SyncTileService"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_tile"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.ACTIVE_TILE"
                android:value="false" />
        </service>

        <!--
          An image arriving from another device is staged in this app's cache
          and put on the clipboard as a content URI, with a read grant attached
          to the clip; a file the user chose to open is staged the same way and
          handed to the opening app. The provider is not exported: only the
          grant lets the other app read it.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.clips"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
