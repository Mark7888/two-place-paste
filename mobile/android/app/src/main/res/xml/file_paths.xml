<?xml version="1.0" encoding="utf-8"?>
<!--
  The directories the FileProvider may hand out: where a received image is
  staged before it goes on the clipboard, where a received file is staged
  while another app opens it, and the Downloads subfolder files are saved to.
  Nothing else is reachable through the provider.
-->
<paths>
    <cache-path name="clips" path="clips/" />
    <cache-path name="open" path="open/" />
    <!--
      Android 9 and older only: a file saved to Downloads/TwoPlacePaste is
      opened from the "Saved" notice through this path. Android 10+ opens it by
      its MediaStore URI instead.
    -->
    <external-path name="downloads" path="Download/TwoPlacePaste/" />
</paths>
