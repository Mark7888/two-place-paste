<?xml version="1.0" encoding="utf-8"?>
<!--
  The two directories the FileProvider may hand out: where a received image is
  staged before it goes on the clipboard, and where a received file is staged
  while another app opens it. Nothing else in this app's storage is reachable
  through the provider.
-->
<paths>
    <cache-path name="clips" path="clips/" />
    <cache-path name="open" path="open/" />
</paths>
