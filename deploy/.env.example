# TwoPlacePaste server configuration.
#
# Copy to .env next to docker-compose.yml and edit. Every value the process
# environment sets wins over this file, so an orchestrator can override one
# without editing it.

## --- Required -------------------------------------------------------------

# The externally reachable origin, scheme included and no trailing path. Every
# creation URL and QR code in the admin UI is built from it (SPEC §3.1, §4.4),
# and its scheme decides whether the admin session cookie is marked Secure —
# keep it https for anything but local development.
TPP_PUBLIC_BASE_URL=https://tpp.example.com

# Admin password for the token screen (SPEC §4.4). Set exactly one of
# ADMIN_PASSWORD and ADMIN_PASSWORD_HASH.
#
# ADMIN_PASSWORD_HASH is accepted by the config loader so that moving to hashed
# storage stays a config change, but verifying a hash is deferred work
# (SPEC §9) and the server refuses to start if it is set. Use ADMIN_PASSWORD.
ADMIN_PASSWORD=change-me

## --- Server ---------------------------------------------------------------

# Listen address inside the container. TLS is terminated by the reverse proxy
# in front of it (SPEC §4.1), so this is plain HTTP.
TPP_HTTP_ADDR=:8080

# Host port the reverse proxy forwards to.
TPP_HOST_PORT=8080

# Host address the published port binds to. The default keeps the server off
# every interface but loopback, which is what a reverse proxy on this same host
# needs and all it needs.
#
# Change it when the proxy is not on this host's loopback — a proxy on another
# machine over a private network, or a host with several addresses where only
# one of them should carry this traffic. Name that one interface: the server
# speaks plain HTTP (SPEC §4.1), so an address the internet can reach publishes
# clipboard traffic without TLS, and "0.0.0.0" is every interface at once.
TPP_HOST_BIND_ADDR=127.0.0.1

# debug, info, warn or error. Debug logs protocol frames and sweep detail; it
# still logs no clipboard content, content type or filename (SPEC §2.3).
TPP_LOG_LEVEL=info

# How long an admin session cookie stays valid.
TPP_ADMIN_SESSION_TTL=12h

# Where the "Source code" link on the admin and pairing pages points (it goes
# through /source). The relay is AGPL-3.0: if you run a modified relay for other
# people, point this at the source of your version. Leave it alone if you run
# the code unmodified.
TPP_SOURCE_URL=https://github.com/Mark7888/two-place-paste

## --- Redis ----------------------------------------------------------------

# Address of the Redis instance. The compose service name resolves on the
# compose network.
TPP_REDIS_ADDR=redis:6379
TPP_REDIS_PASSWORD=
TPP_REDIS_DB=0

## --- Blobs ----------------------------------------------------------------

# Where entries larger than the inline limit are stored: disk (the default)
# or s3 — MinIO, AWS S3 or any S3-compatible store (SPEC §4.3). With s3, the
# server checks the bucket and credentials at startup and refuses to start if
# either is wrong; it never falls back to disk.
TPP_BLOB_BACKEND=disk

# Where the disk backend writes. Layout is <root>/<YYYYMMDDHH>/<entry_id>.bin,
# where the directory is the UTC hour in which the blob expires — that is what
# lets reclamation remove whole directories without consulting Redis
# (SPEC §4.5). In compose this path is a named volume.
TPP_BLOB_ROOT=/var/lib/tpp/blobs

# How often the bucket sweep runs after the pass it makes at startup. The
# startup pass is what makes arbitrary downtime harmless.
TPP_BLOB_SWEEP_INTERVAL=10m

## --- S3 (only with TPP_BLOB_BACKEND=s3) ------------------------------------
#
# MinIO from the compose file — uncomment, pick a secret, and start with
# `docker compose --profile minio up -d`. The same key pair becomes MinIO's
# root credentials, so there is nothing to set up inside MinIO:
#
# TPP_BLOB_BACKEND=s3
# TPP_S3_ENDPOINT=http://minio:9000
# TPP_S3_BUCKET=tpp
# TPP_S3_ACCESS_KEY_ID=tpp
# TPP_S3_SECRET_ACCESS_KEY=change-me-to-at-least-8-chars
# TPP_S3_CREATE_BUCKET=true
#
# AWS S3 — leave the endpoint empty. Leave both keys empty to use the
# instance or task role instead of static keys:
#
# TPP_BLOB_BACKEND=s3
# TPP_S3_REGION=eu-central-1
# TPP_S3_BUCKET=my-tpp-blobs
# TPP_S3_ACCESS_KEY_ID=AKIA...
# TPP_S3_SECRET_ACCESS_KEY=...
#
# All S3 settings:
#
#   TPP_S3_ENDPOINT          host[:port], optionally with http:// or https://.
#                            Empty means AWS.
#   TPP_S3_USE_SSL           true/false. Defaults to true, or false for an
#                            http:// endpoint.
#   TPP_S3_REGION            Defaults to us-east-1.
#   TPP_S3_BUCKET            Required.
#   TPP_S3_PREFIX            Key prefix, so a bucket can be shared. Optional.
#   TPP_S3_ACCESS_KEY_ID     Static credentials. Both empty uses the AWS
#   TPP_S3_SECRET_ACCESS_KEY credential chain. Each also has a _FILE variant
#                            that reads it from a file (Docker secrets).
#   TPP_S3_PATH_STYLE        auto (default), path or virtual. Auto is
#                            path-style for a custom endpoint, virtual-host
#                            style for AWS.
#   TPP_S3_CREATE_BUCKET     true creates a missing bucket at startup.

## --- Storage limits -------------------------------------------------------
#
# Sizes take a plain byte count or a unit: 500MB, 5GiB, 1.5GiB. Only blob
# storage counts — entries small enough to sit inline in Redis are bounded by
# Redis's own maxmemory instead.
#
# When a new entry would not fit, the oldest entries are evicted to make room,
# even inside their 24 hours: first the writing group's own (down to its group
# limit), then the oldest anywhere (down to the total limit). Devices that are
# online are told, and an evicted entry simply reads as gone.

# Total blob storage across all groups. 0 is unlimited. Set it a little under
# the size of the volume (or the bucket's budget).
TPP_BLOB_MAX_TOTAL_BYTES=0

# Blob storage per group, so one busy group cannot evict everyone else's
# entries. 0 is unlimited. Must be at least TPP_ENTRY_MAX_BYTES.
TPP_BLOB_MAX_GROUP_BYTES=1GiB

# Disk backend only: refuse new blobs while the volume has less than this much
# free (plus room for one more entry), whatever the limits above say. It guards
# the host against something else filling the disk. 0 disables the check.
TPP_BLOB_MIN_FREE_BYTES=0

## --- Entry limits (ciphertext) --------------------------------------------

# Ciphertext at or below this size is stored inline in Redis; anything larger
# goes to the blob backend (SPEC §4.3: 256 KB).
TPP_ENTRY_INLINE_MAX_BYTES=256KiB

# Hard per-entry cap, enforced while reading rather than after buffering
# (SPEC §4.3). The server has no knowledge of plaintext size. No frame carries
# more than 10 MiB: a larger entry is uploaded and fetched in chunks.
TPP_ENTRY_MAX_BYTES=50MiB

# Chunk size of the chunked path. At most 10 MiB (one frame); with the s3
# backend at least 5 MiB, because each chunk is a multipart part.
TPP_ENTRY_CHUNK_BYTES=8MiB

# A chunked upload idle this long is abandoned and its reserved room released
# (1m to 1h). An upload may never take longer than an hour in total.
TPP_UPLOAD_SESSION_TTL=10m
